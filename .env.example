# Copy to .env (or export) - every value is optional.
BACKEND=auto              # auto | opencv | insightface
# MATCH_THRESHOLD=0.45    # default depends on backend (opencv 0.363, insightface 0.45)
CONFIRM_FRAMES=3
LIVENESS=off              # on = require natural head movement
ADMIN_PASSWORD=           # set to require login for enroll/delete/settings
SECRET_KEY=               # token signing key; set a long random value in production
ATTENDANCE_TARGET=75
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=attendance@example.edu
